@TechReport{SaneThomas2014_npsforward,
  abstract = {This paper examines the existing implementation of the National Pension Scheme against the goals with which it was created. It finds that there are certain critical areas in which the NPS has deviated. These include multiplicity of schemes, lack of investment choice, low transparency of the system, and a lack of focus on keeping asset management fees low. These gaps are well understood and can be corrected with regulatory interventions. There remain other policy issues that need to be addressed. These include well designed payout policies, and occupational pension systems that will leverage the institutional development of the NPS to include the informalworkforce.},
   author =       {Renuka Sane and Susan Thomas},
   title =        {{The way forward for India's National Pension System}},
   institution =  {{Indira Gandhi Institute of Development Research}},
   year =         2014,
   month =        {July}
}

@TechReport{Aggarwaletal2014_commderivs,
  abstract = {In 2003, trading of commodity futures shifted from single commodity, regional exchanges to national exchanges that trade multiple commodities. This paper examines price discovery and hedging effectiveness of commodity futures after this change and concludes that,on average, futures prices do discover information relatively efficiently, but helps to manage risk less efficiently. The paper uses the viewpoint of the hedger to conjecture what factors may improve hedging effectiveness. These include high settlement costs caused by few and widely dispersed delivery centers and an unreliability of warehouse receipts,a mismatch between the grade specified in the futures contract and what is available for delivery in the market, and disruptions caused by various policy interventions in both commodities spot and futures markets.},
   author =       {Nidhi Aggarwal and Sargam Jain and Susan Thomas},
   title =        {{Do futures markets help in price discovery and
                  risk management}},
   institution =  {{Indira Gandhi Institute of Development Research}},
   year =         2014,
   url =          {http://ifrogs.org/releases/Aggarwaletal2014_pricediscoveryriskmanagementCommodities.html},
   month =        {June}
}

@TechReport{AggarwalThomas2014_atcausal,
  abstract = {The causal impact of algorithmic trading on market quality has been difficult to establish due to endogeneity bias. We address this problem by using the introduction of co-location, an exogenous event after which algorithmic trading is known to increase. Matching procedures are used to identify a matched set of firms and set of dates that are used in a difference-in-difference regression to estimate causal impact. We find that securities with higher algorithmic trading have lower liquidity costs, order imbalance, and order volatility. There is new evidence that higher algorithmic trading leads to lower intraday liquidity risk and a lower incidence of extreme intraday price movements.},
   author =       {Nidhi Aggarwal and Susan Thomas},
   title =        {{The causal impact of algorithmic trading on market
                  quality}},
   institution =  {{Indira Gandhi Institute of Development Research}},
   year =         2014,
   url =          {http://ifrogs.org/releases/ThomasAggarwal2014_algorithmicTradingImpact.html},
   month =        {July}
}

